# === Telegram ===
TELEGRAM_BOT_TOKEN=
# Публичный HTTPS-URL приложения (домен Vercel; для webhook бота и кнопок WebApp)
PUBLIC_URL=https://example.com
# Секрет пути вебхука телеграма (любая случайная строка)
TELEGRAM_WEBHOOK_SECRET=change-me

# === База данных (Supabase) ===
# DATABASE_URL — pooler (порт 6543) с pgbouncer=true; DIRECT_URL — прямое соединение (порт 5432)
# Локально можно указать один и тот же обычный Postgres в обе переменные.
DATABASE_URL=postgresql://cyclefit:cyclefit@localhost:5432/cyclefit
DIRECT_URL=postgresql://cyclefit:cyclefit@localhost:5432/cyclefit

# === Supabase Storage (картинки упражнений; пусто = локальная папка uploads/) ===
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=exercise-images

# === Backend ===
PORT=3000
JWT_SECRET=change-me-long-random-string
# Секрет cron-эндпоинтов (Vercel Cron шлёт его автоматически как Bearer)
CRON_SECRET=change-me-random

# === Admin seed ===
ADMIN_EMAIL=admin@cyclefit.local
ADMIN_PASSWORD=change-me

# === Payments ===
PAYMENTS_MODE=stub
TRIAL_DAYS=7
# Цены тарифов в рублях (для экрана тарифов)
PRICE_MONTHLY=499
PRICE_QUARTERLY=1190
PRICE_YEARLY=3590

# === Dev ===
# В dev-режиме разрешает вход без Telegram (мок initData): НЕ включать в проде
DEV_AUTH_BYPASS=false
