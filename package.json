{
  "name": "cyclefit",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "seed": "pnpm --filter @cyclefit/backend seed",
    "dev:backend": "pnpm --filter @cyclefit/backend dev",
    "dev:miniapp": "pnpm --filter @cyclefit/miniapp dev",
    "dev:admin": "pnpm --filter @cyclefit/admin dev"
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["@prisma/client", "@prisma/engines", "prisma", "esbuild"]
  },
  "packageManager": "pnpm@10.33.0"
}
